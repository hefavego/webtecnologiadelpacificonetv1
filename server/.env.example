# ─────────────────────────────────────────────────────────
#  SERVIDOR NODE.JS — Variables de entorno
#  Copia este archivo como .env y ajusta los valores
# ─────────────────────────────────────────────────────────

# Puerto en que escucha el servidor Node.js (API)
PORT=5000

# ── MySQL / XAMPP ─────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tecnologia_pacifico

# ── CORS: origen permitido (frontend React) ───────────────
CORS_ORIGIN=http://localhost:3001

# ── Entorno ───────────────────────────────────────────────
NODE_ENV=development

# ── WhatsApp Meta Bot Configuration ───────────────────────
# Meta Access Token (Bearer Token)
WHATSAPP_TOKEN=your_meta_access_token_here
# ID de tu número de teléfono de WhatsApp en el portal de desarrolladores de Meta
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
# Token de verificación que tú configuras en el webhook de Meta
WHATSAPP_VERIFY_TOKEN=your_verify_token_here
# Versión de la API de Meta Graph
WHATSAPP_VERSION=v20.0

# ── Gemini API (Opcional para respuestas inteligentes automáticas) ──
# Deja esto en blanco para usar el motor local NLP basado en reglas/palabras clave
GEMINI_API_KEY=your_gemini_api_key_here
